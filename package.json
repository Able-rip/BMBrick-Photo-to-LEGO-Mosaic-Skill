{
  "name": "@bmbrick/photo-to-lego-mosaic-skill",
  "mcpName": "io.github.Able-rip/photo-to-lego-mosaic-skill",
  "version": "2.0.0",
  "description": "Convert any local photo into a LEGO-style brick mosaic preview. MCP server + Node API powered by the BMBrick color quantization engine. Renamed from @bmbrick/agent-mosaic-skill.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Able-rip/agent-mosaic-skill.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp-server.js"
  },
  "bin": {
    "photo-to-lego-mosaic-skill": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync:core": "node scripts/sync-core.js",
    "build": "node scripts/build.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs",
    "prepack": "npm test"
  },
  "keywords": [
    "lego",
    "mosaic",
    "photo-to-lego",
    "lego-mosaic",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent-skill",
    "bmbrick",
    "pixel-art",
    "image-processing",
    "bricks",
    "lego-art"
  ],
  "author": "BMBrick",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "canvas": "^3.2.3",
    "javascript-obfuscator": "^5.4.2",
    "sharp": "^0.34.5"
  }
}
